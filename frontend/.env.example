# ═══════════════════════════════════════════════════════════════
# .env.example — Frontend Environment Variables
# Copy to .env (for local dev) or set in Vercel/Netlify dashboard.
# ═══════════════════════════════════════════════════════════════

# Backend API base URL
# Development: Vite proxy handles this automatically (leave blank or /api)
# Production: set to your deployed backend URL
VITE_API_URL=http://localhost:8000

# App title shown in browser tab
VITE_APP_TITLE=LandWatch NER
