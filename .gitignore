# ═══════════════════════════════════════════════════════════════
# .gitignore — Landslide Early Warning System (SIH)
# ═══════════════════════════════════════════════════════════════

# ── Environment & Secrets ────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────
.venv/
.venv-linux/
venv/
env/
ENV/

# ── ML model files (large binary, regenerate with train_model.py) ─
backend/models/*.pkl
backend/models/*.joblib
# Keep feature_importances.json (small, useful for docs)
!backend/models/feature_importances.json

# ── Database ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ───────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*.orig

# ── Test / coverage ───────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Temp / scratch ────────────────────────────────────────────────
*.tmp
*.bak
scratch/
