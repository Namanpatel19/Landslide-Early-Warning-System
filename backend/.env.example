# ═══════════════════════════════════════════════════════════════
# .env.example — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is listed in .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
# Environment: "development" or "production"
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────
# Frontend origin (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────
# SQLite for prototype. Change to postgresql+asyncpg://user:pass@host/db for production.
DATABASE_URL=sqlite+aiosqlite:///./landslide.db

# ── News API (GNews) ───────────────────────────────────────────────
# Free tier: 100 req/day, no credit card required
# Sign up at: https://gnews.io → Dashboard → API Key
# Supports keyword search for "landslide India" headlines
GNEWS_API_KEY=your_gnews_api_key_here

# ── Sentinel Hub (Satellite Imagery) ──────────────────────────────
# Free account: 30,000 processing units/month (plenty for demos)
# Sign up at: https://www.sentinel-hub.com/develop/api/
# After signup → User Settings → OAuth clients → Create client
# Copy Client ID and Client Secret below:
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id_here
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret_here

# Google Gemini API (Free tier)
# Signup: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── NASA Earthdata (Alternative satellite source) ─────────────────
# Free account: https://urs.earthdata.nasa.gov/
# Used as fallback if Sentinel Hub is unavailable
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_token_here

# ── Optional: Alert notifications (Future Scope) ──────────────────
# Twilio free trial (15 USD credit, no monthly fee):
# https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
